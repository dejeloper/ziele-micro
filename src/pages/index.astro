---
import "../styles/global.css";
import SiteHead from "@/components/layout/SiteHead.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import HeroSection from "@/components/sections/HeroSection.astro";
import PropuestaSection from "@/components/sections/PropuestaSection.astro";
import PreguntasSection from "@/components/sections/PreguntasSection.astro";
import ComoFuncionaSection from "@/components/sections/ComoFuncionaSection.astro";
import ParaQuienSection from "@/components/sections/ParaQuienSection.astro";
import ConfianzaSection from "@/components/sections/ConfianzaSection.astro";
import CtaFinalSection from "@/components/sections/CtaFinalSection.astro";
---

<html lang="es">
  <head>
    <SiteHead />
  </head>
  <body
    class="min-h-dvh select-none overflow-x-hidden bg-zinc-900 text-zinc-100"
  >
    <SiteHeader />

    <main class="mx-auto flex w-full max-w-6xl flex-col" id="top">
      <HeroSection />
      <PropuestaSection />
      <PreguntasSection />
      <ComoFuncionaSection />
      <ParaQuienSection />
      <ConfianzaSection />
      <CtaFinalSection />
    </main>

    <SiteFooter />
  </body>
</html>
