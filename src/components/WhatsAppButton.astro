---
interface Props {
  label: string;
  mobileLabel?: string;
  class?: string;
  variant?: "primary" | "secondary";
  message?: string;
}

const {
  label,
  mobileLabel,
  class: className,
  variant = "primary",
  message = "Hola, quiero contarles un problema que estoy teniendo.",
} = Astro.props;

const WHATSAPP_NUMBER = "573138227185";
const href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;

const base =
  "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-6 py-3 text-sm font-semibold transition-colors duration-200";
const variants = {
  primary: "bg-emerald-500 text-zinc-950 hover:bg-emerald-400",
  secondary:
    "border border-zinc-700 text-zinc-100 hover:border-zinc-500 hover:bg-zinc-900",
};
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[base, variants[variant], className]}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="h-4 w-4 fill-current"
    aria-hidden="true"
  >
    <path
      d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.77.46 3.45 1.27 4.9L2 22l5.25-1.38a9.96 9.96 0 0 0 4.79 1.22h.01c5.52 0 10-4.48 10-10s-4.48-9.84-10.01-9.84Zm5.86 14.2c-.25.7-1.45 1.34-2 1.42-.51.08-1.16.11-1.87-.12-.43-.14-.98-.32-1.69-.63-2.97-1.28-4.9-4.28-5.05-4.48-.15-.2-1.21-1.61-1.21-3.07 0-1.46.77-2.18 1.04-2.48.27-.3.6-.37.8-.37.2 0 .4 0 .57.01.18.01.43-.07.68.52.25.6.85 2.06.92 2.21.07.15.12.33.02.53-.1.2-.15.32-.3.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.61.17.3.77 1.27 1.65 2.06 1.13 1.01 2.09 1.32 2.39 1.47.3.15.47.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.68-.15.27.1 1.73.82 2.03.97.3.15.5.22.57.35.08.13.08.75-.17 1.45Z"
    ></path>
  </svg>
  {
    mobileLabel ? (
      <>
        <span class="hidden sm:inline">{label}</span>
        <span class="sm:hidden">{mobileLabel}</span>
      </>
    ) : (
      label
    )
  }
</a>
