---
import SectionContainer from "@/components/SectionContainer.astro";

const ejemplosAudiencia = [
  "Procesos manuales que consumen horas cada semana",
  "Tareas repetitivas que pasan de una persona a otra",
  "Información dispersa en hojas de cálculo, correos o WhatsApp",
  "Cuellos de botella que retrasan decisiones",
  "Reportes que se arman a mano cada vez",
  "Herramientas desconectadas entre sí",
];
---

<SectionContainer
  id="para-quien"
  class="flex-col gap-10 border-t border-zinc-800 px-6 py-24"
>
  <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-start">
    <div class="max-w-xl">
      <span
        class="text-xs font-mono uppercase tracking-widest text-yellow-400"
      >
        A quién priorizamos
      </span>
      <h2 class="mt-3 text-2xl font-bold text-zinc-50 sm:text-3xl">
        Ayudamos a empresas a resolver procesos que les cuestan tiempo y
        dinero
      </h2>
      <p class="mt-4 text-zinc-400">
        Cualquier persona puede contarnos un problema. Pero damos prioridad
        a situaciones operativas dentro de organizaciones, porque ahí es
        donde un mismo proceso suele afectar a varias personas a la vez.
      </p>
      <p class="mt-4 text-sm text-zinc-500">
        ¿No tienes una empresa pero igual te está pasando algo parecido?
        Escríbenos de todas formas.
      </p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        ejemplosAudiencia.map((ejemplo) => (
          <li class="flex items-start gap-3 rounded-xl border border-zinc-800 bg-zinc-800/30 p-4 text-sm text-zinc-300">
            <span class="mt-0.5 text-yellow-400">✓</span>
            <span>{ejemplo}</span>
          </li>
        ))
      }
    </ul>
  </div>
</SectionContainer>
