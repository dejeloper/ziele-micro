---
import SectionContainer from "@/components/SectionContainer.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
---

<SectionContainer
  id="inicio"
  class="min-h-dvh flex-col-reverse items-center justify-center gap-12 px-6 pt-24 lg:flex-row lg:justify-between"
>
  <div
    class="flex max-w-xl flex-col items-center gap-8 text-center lg:items-start lg:text-left"
  >
    <h1
      id="hero-title"
      class="opacity-0 text-4xl font-bold leading-tight text-zinc-50 sm:text-5xl md:text-6xl"
    >
      ¿Qué proceso te está costando tiempo o dinero?
    </h1>
    <p id="hero-sub" class="opacity-0 text-lg text-zinc-400">
      Ayudamos a empresas a identificar y resolver procesos operativos que
      les quitan tiempo, dinero o esfuerzo. Cuéntanos qué te está pasando;
      nosotros lo investigamos.
    </p>
    <div
      id="hero-cta"
      class="opacity-0 flex flex-col items-center gap-3 lg:items-start"
    >
      <div
        class="flex flex-wrap items-center justify-center gap-4 lg:justify-start"
      >
        <WhatsAppButton
          label="Quiero contarles lo que me está pasando"
          aria-label="Escribir por WhatsApp para contar tu problema"
        />
        <a
          href="#como-funciona"
          class="text-sm font-medium text-zinc-400 underline-offset-4 hover:text-zinc-200 hover:underline"
        >
          ¿Cómo funciona?
        </a>
      </div>
      <p class="text-xs text-zinc-500">
        Normalmente respondemos el mismo día · Tu información no se comparte
        con terceros
      </p>
    </div>
  </div>
  <div
    id="hero-image"
    class="opacity-0 relative w-full max-w-md overflow-hidden rounded-3xl border border-zinc-800 lg:max-w-lg"
  >
    <img
      src="/images/micro-1.webp"
      alt="Un micrófono recibe mensajes, audios y notas de distintas personas y los convierte en información estructurada"
      class="aspect-4/3 w-full object-cover"
      loading="eager"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-zinc-900/60 via-transparent to-transparent"
    >
    </div>
  </div>
</SectionContainer>

<script>
  import { $ } from "@/lib/dom";
  import { gsap, mm, breakpoints, prefersReducedMotion } from "@/lib/gsap";

  const title = $("#hero-title");
  const sub = $("#hero-sub");
  const cta = $("#hero-cta");
  const image = $("#hero-image");

  if (prefersReducedMotion()) {
    gsap.set([title, sub, cta, image], { opacity: 1 });
  } else {
    mm.add(breakpoints, (context) => {
      const { isMobile } = context.conditions as {
        isMobile: boolean;
        isDesktop: boolean;
      };

      const duration = isMobile ? 0.45 : 0.8;
      const overlap = isMobile ? "-=0.3" : "-=0.5";

      gsap.set([title, sub, cta], { y: 20 });
      gsap.set(image, { y: 20, scale: 0.98 });

      gsap
        .timeline({ defaults: { duration, ease: "power2.out" } })
        .to(title, { opacity: 1, y: 0 })
        .to(sub, { opacity: 1, y: 0 }, overlap)
        .to(cta, { opacity: 1, y: 0 }, overlap)
        .to(image, { opacity: 1, y: 0, scale: 1 }, overlap);
    });
  }
</script>
